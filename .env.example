# ---- App ----
ENVIRONMENT=development
APP_NAME=event-platform-backend
API_V1_PREFIX=/api/v1

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/event_platform

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Auth / JWT ----
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- OTP ----
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_HASH_PEPPER=change-this-too

# ---- Identity document encryption ----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IDENTITY_DOC_ENCRYPTION_KEY=

# ---- SMS provider (stub in Phase 1) ----
SMS_PROVIDER_API_KEY=